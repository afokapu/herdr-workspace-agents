#!/usr/bin/env python3
"""herdr-navigator — herdr's workspace navigator, scoped to one workspace, in a pane.

herdr 0.7.4's own navigator spans every workspace. Its socket API has no filter: the
complete `agent.*` surface is explain/focus/get/list/read/rename/send/start, `agent.list`
takes EmptyParams, and there is no `agent.view.*` method. So a workspace-scoped navigator
cannot be requested — it has to be derived, which is what this does.

`events.subscribe` is a real push stream carrying `workspace.focused`, so the view
re-scopes itself when you switch workspaces. No polling.

Usage:
    herdr-navigator                 # follow the focused workspace
    herdr-navigator --workspace wY  # pin to one workspace
    herdr-navigator --once          # print once and exit
    herdr-navigator --plain         # no ANSI, for piping

Keys:  j/k or up/down move   enter switch   / search   b/w/i/d/a states   esc, q close
       i/s/t toggle the pane-id, status and title columns
"""

from __future__ import annotations

import argparse
import json
import os
import select
import shutil
import socket
import sys
import termios
import tty

# herdr has no subscribable agent.* event — the Subscription enum covers workspace.*,
# worktree.*, tab.* and pane.* only, and the per-pane variants need a pane_id. So
# `agent.rename` reaches us through no event at all. This is the floor that catches it.
FALLBACK_REPAINT_SECONDS = 20

SOCKET = os.environ.get("HERDR_SOCK", os.path.expanduser("~/.config/herdr/herdr.sock"))

SUBSCRIPTIONS = [
    {"type": "workspace.focused"},
    {"type": "pane.updated"},
    {"type": "pane.created"},
    {"type": "pane.closed"},
    {"type": "pane.exited"},
    {"type": "tab.renamed"},
    {"type": "tab.created"},
    {"type": "tab.closed"},
]

DOT = {
    "working": ("\033[32m", "◆"),
    "blocked": ("\033[31m", "●"),
    "idle":    ("\033[33m", "○"),
    "done":    ("\033[90m", "✓"),
}
RESET, BOLD, DIM, INVERT = "\033[0m", "\033[1m", "\033[2m", "\033[7m"
ACCENT = "\033[38;5;215m"          # amber, matching herdr's own selection bar

MOUSE_ON = "\033[?1000h\033[?1006h"
MOUSE_OFF = "\033[?1006l\033[?1000l"

STATE_KEYS = {"b": "blocked", "w": "working", "i": "idle", "d": "done", "a": None}


class Herdr:
    def __init__(self, path: str = SOCKET) -> None:
        self.path = path

    def call(self, method: str, params: dict | None = None, timeout: float = 5.0) -> dict:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        try:
            s.connect(self.path)
            s.sendall((json.dumps({"id": method, "method": method,
                                   "params": params or {}}) + "\n").encode())
            buf = b""
            while b"\n" not in buf:
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
            return json.loads(buf.split(b"\n", 1)[0] or b"{}")
        finally:
            s.close()

    def subscribe(self, subs: list[dict]) -> socket.socket:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.connect(self.path)
        s.sendall((json.dumps({"id": "sub", "method": "events.subscribe",
                               "params": {"subscriptions": subs}}) + "\n").encode())
        ack = json.loads(s.makefile("r", encoding="utf-8").readline() or "{}")
        if "error" in ack:
            raise RuntimeError(f"events.subscribe refused: {ack['error']}")
        return s


def _walk(obj, key):
    """herdr nests its payloads; find the first list stored under `key`."""
    if isinstance(obj, dict):
        if key in obj and isinstance(obj[key], list):
            return obj[key]
        for v in obj.values():
            found = _walk(v, key)
            if found:
                return found
    elif isinstance(obj, list):
        for v in obj:
            found = _walk(v, key)
            if found:
                return found
    return []


def focused_workspace(h: Herdr) -> str | None:
    for ws in _walk(h.call("workspace.list"), "workspaces"):
        if ws.get("focused"):
            return ws.get("workspace_id")
    return None


class View:
    """Everything the navigator draws, and the rows a key or click can act on."""

    def __init__(self) -> None:
        self.lines: list[str] = []
        self.targets: list[dict] = []     # one per selectable row, in render order
        self.row_of: dict[int, int] = {}  # screen row (1-based) -> index into targets


def build(h: Herdr, ws_id: str | None, cols: dict, search: str,
          state: str | None, selected: int, plain: bool, width: int,
          collapsed: set[str] | None = None) -> View:
    v = View()
    collapsed = collapsed or set()
    if ws_id is None:
        v.lines = ["workspace: COULD-NOT-READ - showing nothing rather than everything"]
        return v

    label = ws_id
    for ws in _walk(h.call("workspace.list"), "workspaces"):
        if ws.get("workspace_id") == ws_id:
            label = ws.get("label") or ws_id
            break

    tabs = [t for t in _walk(h.call("tab.list", {"workspace_id": ws_id}), "tabs")
            if t.get("workspace_id") == ws_id]
    panes = [p for p in _walk(h.call("pane.list", {"workspace_id": ws_id}), "panes")
             if p.get("workspace_id") == ws_id]
    by_tab: dict[str, list[dict]] = {}
    for p in panes:
        by_tab.setdefault(p.get("tab_id", ""), []).append(p)

    def keep(text: str, st: str | None) -> bool:
        if search and search.lower() not in text.lower():
            return False
        if state and st != state:
            return False
        return True

    # header + search line, mirroring herdr's own chrome
    head = f"{label}  ({ws_id})"
    if search:
        head += f"   / {search}"
    if state:
        head += f"   [{state}]"
    v.lines.append(head if plain else f"{BOLD}{head}{RESET}")

    for t in sorted(tabs, key=lambda x: x.get("number", 0)):
        tid = t.get("tab_id", "")
        kids = sorted(by_tab.get(tid, []), key=lambda x: x.get("pane_id", ""))
        tab_text = f"{t.get('number','?')} {tid} {t.get('label') or ''}"
        shown = [p for p in kids
                 if keep(f"{p.get('pane_id','')} {p.get('label') or p.get('name') or ''}",
                         p.get("agent_status"))]
        # a tab survives if it matches, or if any of its panes do
        if not keep(tab_text, t.get("agent_status")) and not shown:
            continue

        v.targets.append({"kind": "tab", "id": tid,
                          "focus": {"tab_id": tid}, "label": t.get("label") or tid})
        v.row_of[len(v.lines) + 1] = len(v.targets) - 1
        st = t.get("agent_status") or "-"
        colour, glyph = DOT.get(st, ("\033[35m", "·"))
        here = "→" if t.get("focused") else " "
        # A tab with no panes gets a space, not a triangle: there is nothing to expand,
        # and a triangle that does nothing is a lie about what the key will do.
        tri = " " if not kids else ("▸" if tid in collapsed else "▾")
        left = f"{here}{tri}{glyph} "
        if cols["id"]:
            left += f"{t.get('number','?'):<2} {tid:<7} "
        right = f"{len(kids)} panes"
        v.lines.append(_row(left, t.get("label") or "", right, width,
                            plain, colour, len(v.targets) - 1 == selected,
                            bold=True))

        if tid in collapsed:
            continue
        for p in (shown if (search or state) else kids):
            pid = p.get("pane_id", "")
            v.targets.append({"kind": "pane", "id": pid, "parent": tid,
                              "focus": {"pane_id": pid},
                              "label": p.get("label") or p.get("name") or pid})
            v.row_of[len(v.lines) + 1] = len(v.targets) - 1
            pst = p.get("agent_status") or "-"
            pcol, pglyph = DOT.get(pst, ("\033[35m", "·"))
            mark = "◆" if p.get("focused") else " "
            left = f" {mark}├─{pglyph} "
            if cols["id"]:
                left += f"{pid.split(':')[-1]:<4} "
            name = p.get("label") or p.get("name") or p.get("terminal_title_stripped") or ""
            agent = p.get("agent") or "shell"
            right = f"{agent} · {pst}" if cols["status"] else agent
            v.lines.append(_row(left, name if cols["title"] else "", right, width,
                                plain, pcol, len(v.targets) - 1 == selected))
    if not v.targets:
        v.lines.append("  (nothing matches)")
    return v


def _row(left: str, mid: str, right: str, width: int, plain: bool,
         colour: str, is_sel: bool, bold: bool = False) -> str:
    """left + title, with `right` pushed to the margin; title truncates, ids never do."""
    room = width - len(left) - len(right) - 1
    body = _fit_title(mid, max(0, room))
    line = left + body + " " * max(1, room - len(body)) + right
    line = line[:width]
    if plain:
        return line
    if is_sel:
        return f"{INVERT}{ACCENT}{line.ljust(width)}{RESET}"
    return f"{colour}{left}{RESET}{BOLD if bold else ''}{body}{RESET}" \
           f"{' ' * max(1, room - len(body))}{DIM}{right}{RESET}"


def _fit(text: str, width: int) -> str:
    if width <= 3 or len(text) <= width:
        return text[:width] if width > 0 else ""
    return text[: width - 3] + "..."


def _fit_title(title: str, width: int) -> str:
    """Truncate a title without losing its identifiers: `#<issue> pr<pr>` is held back."""
    if len(title) <= width:
        return title
    head, _, tail = title.partition(" ")
    ids = head
    if tail.startswith(("pr", "PR")):
        pr, _, rest = tail.partition(" ")
        ids, tail = f"{head} {pr}", rest
    if len(ids) >= width:
        return _fit(ids, width)
    if len(ids) + 4 > width:
        return ids
    return ids + " " + _fit(tail, width - len(ids) - 1)


def footer(cols: dict, state: str | None, plain: bool, width: int) -> str:
    txt = (" enter switch   / search   b/w/i/d/a states   j/k move   h/l fold   z all"
           f"   [i]{'+' if cols['id'] else '-'}id"
           f" [s]{'+' if cols['status'] else '-'}status")
    txt = _fit(txt, width)
    return txt if plain else f"{INVERT}{txt.ljust(width)}{RESET}"


def _fold(view: "View", idx: int, collapsed: set[str], expand: bool | None) -> None:
    """Fold or unfold the tab at `idx`. On a pane row, act on its parent tab.

    `expand=None` toggles. Acting on a pane's parent is what makes `h` useful from
    anywhere in a subtree — otherwise you would have to navigate back up to collapse
    the thing you are already inside.
    """
    if not (0 <= idx < len(view.targets)):
        return
    target = view.targets[idx]
    tid = target["id"] if target["kind"] == "tab" else target.get("parent")
    if not tid:
        return
    if expand is True:
        collapsed.discard(tid)
    elif expand is False:
        collapsed.add(tid)
    else:
        collapsed.discard(tid) if tid in collapsed else collapsed.add(tid)


def _read_escape(stream) -> str:
    """Read the rest of an escape sequence after an ESC byte.

    The FIRST byte gets a generous wait. A terminal delivers `ESC [ A` as one burst, but
    not always in one read — with a 50ms window an arrow key could return "" here and be
    mistaken for a lone ESC, which closed the popup instead of moving the cursor. A real
    lone ESC still resolves in 200ms, which is imperceptible.
    """
    seq = ""
    for i in range(32):
        r, _, _ = select.select([stream], [], [], 0.2 if i == 0 else 0.05)
        if not r:
            break
        c = stream.read(1)
        seq += c
        if c in "Mm~" or (seq.startswith("[") and c.isalpha() and c != "<"):
            break
    return seq


def _click_row(seq: str) -> tuple[int | None, bool]:
    """(screen_row, was_a_button0_press). Row is None for anything else."""
    if not seq.startswith("[<") or not seq.endswith("M"):
        return None, False
    try:
        button, _col, row = seq[2:-1].split(";")
        return (int(row), True) if int(button) == 0 else (None, False)
    except ValueError:
        return None, False


def main() -> int:
    ap = argparse.ArgumentParser(prog="herdr-navigator",
                                 description="herdr's workspace navigator, in a pane.")
    ap.add_argument("--workspace")
    ap.add_argument("--once", action="store_true")
    ap.add_argument("--plain", action="store_true")
    ap.add_argument("--no-id", action="store_true")
    ap.add_argument("--no-status", action="store_true")
    ap.add_argument("--no-title", action="store_true")
    args = ap.parse_args()

    cols = {"id": not args.no_id, "status": not args.no_status, "title": not args.no_title}
    h = Herdr()
    try:
        h.call("workspace.list", timeout=2.0)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"cannot reach herdr at {SOCKET}: {exc}", file=sys.stderr)
        return 1

    pinned = args.workspace
    ws = pinned or focused_workspace(h)
    search, state, selected = "", None, 0
    searching = False
    collapsed: set[str] = set()

    if args.once:
        w = shutil.get_terminal_size(fallback=(80, 24)).columns
        print("\n".join(build(h, ws, cols, search, state, -1, args.plain, w, collapsed).lines))
        return 0

    stream = h.subscribe(SUBSCRIPTIONS)
    reader = stream.makefile("r", encoding="utf-8")
    view = View()

    def paint():
        nonlocal view, selected
        size = shutil.get_terminal_size(fallback=(80, 24))
        view = build(h, ws, cols, search, state, selected, args.plain, size.columns,
                     collapsed)
        selected = max(0, min(selected, len(view.targets) - 1)) if view.targets else 0
        sys.stdout.write("" if args.plain else "\033[H\033[J")
        body = view.lines[: max(1, size.lines - 2)]
        print("\n".join(body), flush=True)
        if interactive:
            prompt = f"/ {search}" if searching else footer(cols, state, args.plain, size.columns)
            print(prompt, end="", flush=True)

    interactive = sys.stdin.isatty()
    saved = None
    if interactive:
        try:
            saved = termios.tcgetattr(sys.stdin)
            tty.setcbreak(sys.stdin.fileno())
            sys.stdout.write(MOUSE_ON)
            sys.stdout.flush()
        except (termios.error, ValueError):
            interactive = False

    def go(idx: int) -> bool:
        if 0 <= idx < len(view.targets):
            h.call("pane.focus" if view.targets[idx]["kind"] == "pane" else "tab.focus",
                   view.targets[idx]["focus"])
            return True
        return False

    paint()
    try:
        while True:
            watch = [stream] + ([sys.stdin] if interactive else [])
            ready, _, _ = select.select(watch, [], [], FALLBACK_REPAINT_SECONDS)
            if not ready:
                paint()
                continue

            if interactive and sys.stdin in ready:
                ch = sys.stdin.read(1)

                if searching:                         # typing a filter
                    if ch in ("\r", "\n"):
                        searching = False
                    elif ch == "\033":
                        _read_escape(sys.stdin)
                        searching, search = False, ""
                    elif ch in ("\x7f", "\b"):
                        search = search[:-1]
                    elif ch.isprintable():
                        search += ch
                    selected = 0
                    paint()
                elif ch == "\033":
                    seq = _read_escape(sys.stdin)
                    if seq == "":                     # bare ESC closes
                        return 0
                    if seq in ("[A", "[B"):
                        selected += -1 if seq == "[A" else 1
                        paint()
                    elif seq in ("[C", "[D"):        # right / left
                        _fold(view, selected, collapsed, expand=(seq == "[C"))
                        paint()
                    elif seq.startswith("[<"):
                        row, pressed = _click_row(seq)
                        if pressed:
                            idx = view.row_of.get(row or -1)
                            if idx is not None and go(idx):
                                return 0
                            return 0                  # clicked off the list: dismiss
                elif ch in ("\r", "\n"):
                    if go(selected):
                        return 0
                elif ch == "/":
                    searching, search = True, ""
                    paint()
                elif ch in ("j", "k"):
                    selected += 1 if ch == "j" else -1
                    paint()
                elif ch in ("h", "l", " "):
                    _fold(view, selected, collapsed,
                          expand=None if ch == " " else (ch == "l"))
                    paint()
                elif ch == "z":                      # fold or unfold everything
                    all_tabs = {t["id"] for t in view.targets if t["kind"] == "tab"}
                    collapsed.clear() if collapsed else collapsed.update(all_tabs)
                    selected = 0
                    paint()
                elif ch in STATE_KEYS:
                    state = STATE_KEYS[ch]
                    selected = 0
                    paint()
                elif ch == "q":
                    return 0
                elif ch in ("t",):
                    cols["title"] ^= True
                    paint()
                if stream not in ready:
                    continue

            line = reader.readline()
            if not line:
                return 1
            try:
                ev = json.loads(line.strip() or "{}")
            except json.JSONDecodeError:
                continue
            if _event_kind(ev) == "workspace_focused" and not pinned:
                ws = _event_field(ev, "workspace_id") or ws
                selected = 0
            paint()
    except KeyboardInterrupt:
        return 0
    except OSError as exc:
        print(f"\nevent stream closed: {exc}", file=sys.stderr)
        return 1
    finally:
        if saved is not None:
            sys.stdout.write(MOUSE_OFF)
            sys.stdout.flush()
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, saved)
        stream.close()


def _event_kind(ev: dict) -> str:
    for key in ("event", "type"):
        v = ev.get(key) or ev.get("result", {}).get(key)
        if isinstance(v, str):
            return v
    return ""


def _event_field(ev: dict, field: str):
    if field in ev:
        return ev[field]
    return ev.get("result", {}).get(field) or ev.get("params", {}).get(field)


if __name__ == "__main__":
    sys.exit(main())
